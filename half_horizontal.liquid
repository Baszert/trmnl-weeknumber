<div class="layout w--full h--full bg--white relative overflow--hidden font--sans rounded">
  
  <div class="absolute top--0 left--0 w--full h--full grid grid--cols-1 z--1">
    <div class="col col--center row--center text--center">
      <span class="block text--uppercase text--bold text text--large lg:text--xxlarge">Week</span>
      <span class="block text--bold text text--tera lg:text--peta">{{ current_week }}</span>
    </div>
  </div>

  <div class="absolute top--0 left--0 h--full bg--white z--2 blend--difference" style="width: {{ progress_pct }}%;"></div>

</div>