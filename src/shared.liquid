{% comment %} Local time, so the week flips at the user's Monday 00:00, not UTC {% endcomment %}
{% assign current_timestamp = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset %}
{% assign current_week = current_timestamp | date: "%V" | plus: 0 %}
{% assign total_weeks = 52.0 %}
{% assign progress_pct = current_week | divided_by: total_weeks | times: 100 %}

{% if progress_pct > 100 %}
{% assign progress_pct = 100 %}
{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap" rel="stylesheet">

<style>
  /* Scoped to .weeknumber-plugin so these don't leak into other plugins in a mashup.
     Some helpers sit on the root itself, hence both ".x.y" and ".x .y". */
  .weeknumber-plugin {
    font-family: "Google Sans Flex";
  }

  .weeknumber-plugin.relative, .weeknumber-plugin .relative {
    position: relative;
  }

  .weeknumber-plugin .absolute {
    position: absolute;
  }

  .weeknumber-plugin .top--0 {
    top: 0;
  }

  .weeknumber-plugin .left--0 {
    left: 0;
  }

  .weeknumber-plugin .z--1 {
    z-index: 1;
  }

  .weeknumber-plugin .z--2 {
    z-index: 2;
  }

  .weeknumber-plugin .text--bold {
    font-weight: bold;
  }

  .weeknumber-plugin.overflow--hidden, .weeknumber-plugin .overflow--hidden {
    overflow: hidden;
  }

  .weeknumber-plugin .text--uppercase {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    line-height: 1em;
  }

  .weeknumber-plugin .font--bold {
    font-weight: bold !important;
  }

  .weeknumber-plugin .blend--difference {
    mix-blend-mode: difference;
  }
</style>
